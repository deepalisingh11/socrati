{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DOCUMENT_WORKER_CONCURRENCY",
    "EMBEDDING_MOCK",
    "GEMINI_API_KEY",
    "GROQ_API_KEY",
    "REDIS_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "UPSTASH_REDIS_CONNECTION_STRING",
    "UPSTASH_REDIS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
